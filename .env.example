# ---- Application mode ----
# mock (default): deterministic, no external calls. real: use OpenAI-compatible providers.
APP_MODE=mock
APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=true

# ---- API / security ----
# Demo API key for the simple header auth. Replace in real deployments / use OAuth2/OIDC.
API_AUTH_ENABLED=true
DEMO_API_KEY=changeme-dev-key
DEFAULT_TENANT=public
MAX_UPLOAD_MB=10
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.md,.txt

# ---- Database ----
# Local default is SQLite; Docker Compose overrides with Postgres.
DATABASE_URL=sqlite+aiosqlite:///./data/copilot.db
# Example Postgres: postgresql+asyncpg://copilot:copilot@postgres:5432/copilot

# ---- Vector store ----
# memory (default) or qdrant
VECTOR_STORE=memory
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=copilot_chunks

# ---- LLM provider (used only when APP_MODE=real) ----
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=800
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---- Retrieval / RAG ----
CHUNK_STRATEGY=recursive
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_MODE=hybrid
TOP_K=5
RERANK_ENABLED=true
SCORE_THRESHOLD=0.15
ENABLE_QUERY_REWRITE=false

# ---- Agent ----
AGENT_MAX_STEPS=6
AGENT_MAX_RETRIES=2

# ---- Provider reliability ----
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
